# =============================================================================
# Alertmanager 生产环境变量清单
# =============================================================================
# 将此文件复制为 alerts.env 并填入真实值，用于 docker-compose 部署:
#
#   cp monitoring/alertmanager/alerts.env.example alerts.env
#   # 编辑 alerts.env 填入真实值
#   # 在 alertmanager 服务中: env_file: alerts.env
#
# 验证:
#   bash scripts/verify-secrets.sh --strict
#   # 应显示: ✅ 未发现 CHANGE_ME / 占位符
# =============================================================================

# --- Slack Webhook URL（必填）---
# 用于 default-receiver (#monitoring)、p0-oncall (#incident)、
# p1-oncall (#alerts)、p2-summary (#monitoring) 4 个 channel
# 格式: https://hooks.slack.com/services/Txxx/Bxxx/xxxxx
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME

# --- PagerDuty 集成密钥（P0 必填）---
# Events API v2 集成密钥，从 PagerDuty → Developer Tools → Service Directories 获取
PAGERDUTY_SERVICE_KEY=CHANGE_ME

# --- SMTP 密码（可选，用于邮件通知）---
# Gmail: 使用 App Password
# Office 365: 使用 SMTP Auth 密码
# 自建: 使用实际 SMTP 密码
SMTP_PASSWORD=CHANGE_ME
