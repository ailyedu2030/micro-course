# Staging deploy defaults
# 复制为 .env.staging 后按目标机器实际值修改

DB_USERNAME=postgres
DB_PASSWORD=staging123

JWT_SECRET=staging_jwt_secret_replace_with_64_char_random_value_2026_microcourse
VIDEO_SIGN_SECRET=staging_video_secret_replace_with_64_char_random_value_2026_mc

# 字段级加密密钥 (KEY=32字节=64 hex字符, SALT=8字节=16 hex字符; 生成: openssl rand -hex 32 / openssl rand -hex 8; 生产必填, 缺则 fail-fast)
APP_SECURITY_FIELD_ENCRYPTION_KEY=replace_with_64_hex_chars_openssl_rand_hex_32
APP_SECURITY_FIELD_ENCRYPTION_SALT=replace_16_hex_openssl_rand_hex_8

REDIS_PASSWORD=
JWT_EXPIRATION=7200000
JWT_REFRESH_EXPIRATION=604800000

STAGING_WEB_PORT=18080
STAGING_API_PORT=18081
STAGING_DB_PORT=15432
STAGING_REDIS_PORT=16379
STAGING_CORS_ALLOWED_ORIGINS=http://localhost:18080,http://127.0.0.1:18080

DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
PROD_ALLOW_MOCK_PAYMENT=true
PLUGIN_INTERACTIVE_ENABLED=true
SLIDES_STORAGE_PATH=uploads/slides
